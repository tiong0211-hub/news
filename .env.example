# Naver Developers > Application > 검색 API 사용 설정 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kakao Developers 앱의 REST API 키
KAKAO_REST_API_KEY=
# scripts/kakao_auth.py 실행 후 발급되는 refresh token
KAKAO_REFRESH_TOKEN=
# scripts/kakao_auth.py 실행 시에만 사용 (앱 설정한 Redirect URI와 동일해야 함)
KAKAO_REDIRECT_URI=https://example.com/oauth

# (선택) Kakao refresh token이 회전될 때 GitHub Secret(KAKAO_REFRESH_TOKEN)을 자동 갱신하려면
# repo, workflow 권한을 가진 Personal Access Token을 등록하세요. 비워두면 자동 갱신을 건너뜁니다.
GH_PAT=

# 아래 두 값은 GitHub Actions에서 자동으로 채워집니다. 로컬 테스트 시엔 GH_PAT를 비워두면 무시됩니다.
GITHUB_REPOSITORY=

# 뉴스 검색 키워드 (쉼표로 구분, 필요에 맞게 수정)
NAVER_QUERIES=경제,증시,코스피,금리,환율,부동산,수출입
GOOGLE_NEWS_QUERIES=economy,stock market,federal reserve,inflation,interest rates

# 최종 선별 뉴스 개수
TOP_N=10
# 카카오톡 메시지 한 건당 최대 글자 수 (기본 템플릿 text 필드 제한을 고려한 값)
KAKAO_TEXT_MAX_LEN=180
