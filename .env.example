# Naver Cloud Platform(NCP) 콘솔 > Search(뉴스 검색) API 신청 후 발급되는 Application key
# (Client ID = X-NCP-APIGW-API-KEY-ID, Client Secret = X-NCP-APIGW-API-KEY)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kakao Developers 앱의 REST API 키
KAKAO_REST_API_KEY=
# 앱 키 > 클라이언트 시크릿이 "카카오 로그인"에 대해 활성화(ON)되어 있다면 그 코드 값을 입력.
# 비활성화 상태라면 비워둬도 됨.
KAKAO_CLIENT_SECRET=
# scripts/kakao_auth.py 실행 후 발급되는 refresh token
KAKAO_REFRESH_TOKEN=
# scripts/kakao_auth.py 실행 시에만 사용 (앱 설정한 Redirect URI와 동일해야 함)
KAKAO_REDIRECT_URI=https://example.com/oauth

# (선택) Kakao refresh token이 회전될 때 GitHub Secret(KAKAO_REFRESH_TOKEN)을 자동 갱신하려면
# repo, workflow 권한을 가진 Personal Access Token을 등록하세요. 비워두면 자동 갱신을 건너뜁니다.
GH_PAT=

# 아래 두 값은 GitHub Actions에서 자동으로 채워집니다. 로컬 테스트 시엔 GH_PAT를 비워두면 무시됩니다.
GITHUB_REPOSITORY=

# 국내 뉴스 검색 키워드 (쉼표로 구분, 필요에 맞게 수정)
NAVER_QUERIES=경제,증시,코스피,금리,환율,부동산,수출입

# 신뢰 언론사 도메인 (쉼표로 구분). 국내는 수집 후 필터링, 해외는 Google News site: 검색으로 적용됨.
DOMESTIC_SOURCE_DOMAINS=mk.co.kr,hankyung.com,mt.co.kr,heraldcorp.com,biz.chosun.com,fnnews.com
FOREIGN_SOURCE_DOMAINS=wsj.com,ft.com,nikkei.com

# 최종 선별 뉴스 개수
TOP_N=10

# src/send_kakao.py 실행 시 카카오 메시지에 넣을 뉴스레터 페이지 URL (로컬 테스트용).
# GitHub Actions에서는 GitHub Pages 배포 후 자동으로 채워집니다.
PAGE_URL=
